# ==============================================================================
# DSM-5 PSYCHIATRY & CLINICAL PSYCHOLOGY AI ASSISTANT
# Environment Configuration Template
# ==============================================================================

# Application Meta
APP_NAME="DSM-5 Psychiatry & Clinical Psychology AI Assistant"
APP_ENV="development" # development | staging | production
DEBUG=true
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_V1_STR="/api/v1"
SECRET_KEY="change-this-in-production-super-secret-key-at-least-32-chars-long"
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["*"]

# Database & Storage
# PostgreSQL database URL (Render / Supabase / Neon PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/dsm5_psychiatry"
REDIS_URL="redis://localhost:6379/0"

# Active Providers Config
# Active LLM Provider: groq | openai | anthropic | google_gemini | openrouter | ollama
ACTIVE_LLM_PROVIDER="groq"
# Active Embedding Provider: openai | bge | e5 | sentence_transformers
ACTIVE_EMBEDDING_PROVIDER="openai"
EMBEDDING_DIMENSION=1536

# Provider API Keys
GROQ_API_KEY="gsk_your-groq-api-key"
OPENAI_API_KEY="sk-proj-your-openai-api-key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"
GEMINI_API_KEY="your-gemini-api-key"
OPENROUTER_API_KEY="sk-or-your-openrouter-api-key"
OLLAMA_BASE_URL="http://localhost:11434"

# RAG & Chunking
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# Rate Limiting & Security
RATE_LIMIT_PER_MINUTE=60
MAX_TOKENS_PER_SESSION=50000
MAX_CONVERSATION_HISTORY=20
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
